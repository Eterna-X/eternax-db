# Copy to .env (git-ignored) in the service's folder for local development.
# Real environment variables and Kubernetes secrets win over this file.
# Default if DB_URL is not set: jdbc:postgresql://localhost:5432/<the service's database>
DB_URL=jdbc:postgresql://localhost:5432/audit
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=20
# Migrations as the table owner (audit-service, AUD-07); leave out to migrate as DB_USER
# SPRING_FLYWAY_USER=
# SPRING_FLYWAY_PASSWORD=
